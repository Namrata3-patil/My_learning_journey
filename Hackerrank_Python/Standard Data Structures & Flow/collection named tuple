from collections import namedtuple

# Read the number of students
n = int(input())

# Read the column names in any order
columns = input().split()

# Create a namedtuple called 'Student' with the given column names
Student = namedtuple('Student', columns)

# Accumulate total marks
total_marks = 0
for _ in range(n):
  # Read each student's data and unpack into the Student namedtuple
  student = Student(*input().split())
  total_marks += int(student.MARKS)

# Print the average marks formatted to 2 decimal places
print('{:.2f}'.format(total_marks / n))
